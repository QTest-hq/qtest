# GitHub App Configuration for QTest
# Copy this file to .env and fill in your values

# GitHub App ID (found on your app's settings page)
GITHUB_APP_ID=

# Path to your GitHub App's private key file (PEM format)
# Download this from your GitHub App settings page
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# OR provide the private key directly (base64 encoded or raw PEM)
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# Webhook secret (configured when setting up webhooks)
GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret

# Personal access token (optional, for fallback authentication)
# GITHUB_TOKEN=ghp_...

# QTest API Configuration
PORT=8080
DATABASE_URL=postgres://user:pass@localhost:5432/qtest?sslmode=disable
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_TIER1_MODEL=qwen2.5-coder:7b
OLLAMA_TIER2_MODEL=deepseek-coder-v2:16b
